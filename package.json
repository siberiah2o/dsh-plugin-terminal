{
  "name": "dsh-plugin-terminal",
  "version": "0.1.0",
  "description": "Bottom terminal panel plugin for DeepSeek Harness Web GUI (node-pty powered, works on Windows via ConPTY)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siberiah2o/dsh-plugin-terminal.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "terminal",
    "pty",
    "plugin"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "README.zh.md"
  ]
}
